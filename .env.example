# ==============================================================================
# Enterprise RAG - Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================================

# --- Reasoning Engine (Groq) ---
GROQ_API_KEY="your-groq-api-key"
GROQ_FALLBACK_API_KEY="your-optional-fallback-groq-api-key"

# --- Vector Database (Qdrant) ---
QDRANT_API_KEY="your-qdrant-api-key"
QDRANT_CLUSTER_ENDPOINT="https://your-cluster-id.region.gcp.cloud.qdrant.io"

# --- LLM Gateway (Portkey) ---
PORTKEY_API_KEY="your-portkey-api-key"

# --- Observability & Tracing (Logfire & LangSmith) ---
LOGFIRE_TOKEN="your-logfire-token"

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="your-langsmith-api-key"
LANGSMITH_PROJECT="enterprise-rag"

# --- Google Cloud Platform (GCP) ---
PROJECT_ID="your-gcp-project-id"
LOCATION="us-central1"
GCP_DOC_AI_LOCATION="us"
GCP_DOC_AI_PROCESSOR_ID="your-document-ai-processor-id"
GCP_RAW_BUCKET="your-gcp-raw-bucket-name"
GCP_PROCESSED_BUCKET="your-gcp-processed-bucket-name"
VPC_CONNECTOR="your-vpc-connector-name"
